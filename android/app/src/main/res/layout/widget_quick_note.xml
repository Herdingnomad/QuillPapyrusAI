<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_gruvbox"
    android:padding="12dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="#EBDBB2"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Daily Note Action Button -->
        <TextView
            android:id="@+id/btn_widget_daily_note"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="Daily"
            android:textColor="#FABD2F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <!-- Quick Note Action Button -->
        <TextView
            android:id="@+id/btn_widget_quick_note"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_action_btn"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="+ Note"
            android:textColor="#1D2021"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tap to Type Bar (Opens QuickCaptureActivity over home screen) -->
    <LinearLayout
        android:id="@+id/widget_tap_to_type_bar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_note_add"
            android:contentDescription="Type note" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Tap to type quick note..."
            android:textColor="#A89984"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_save"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="✍️ Type"
            android:textColor="#1D2021"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Recent Scratchpad Card -->
    <LinearLayout
        android:id="@+id/widget_recent_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_button"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_widget_recent_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap + Note to capture your thoughts"
            android:textColor="#EBDBB2"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_widget_recent_snippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="On-device Markdown IDE with local Gemma AI"
            android:textColor="#A89984"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
